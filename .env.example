# ==============================================================================
# JobPilot AI — Environment Configuration Template
# ==============================================================================
# DO NOT store real secrets in this file. Copy this file to .env.local and populate
# with your own official credentials. Never commit real keys to version control.
# ==============================================================================

# Node & Next.js Environment
NODE_ENV=production
PORT=3000

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/jobpilot_ai

# Server-Side Token Encryption Key (AES-256-GCM 32-byte secret)
ENCRYPTION_KEY=replace_with_32_byte_secure_random_hex_key_here
SESSION_SECRET=replace_with_secure_session_secret_string_here

# Official LinkedIn Developer App Credentials (OAuth 2.0)
LINKEDIN_CLIENT_ID=your_official_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_official_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# Official Naukri Developer API Credentials
NAUKRI_CLIENT_ID=your_official_naukri_client_id
NAUKRI_CLIENT_SECRET=your_official_naukri_client_secret
NAUKRI_REDIRECT_URI=http://localhost:3000/api/auth/callback/naukri

# Official Indeed Developer App Credentials (OAuth 2.0)
INDEED_CLIENT_ID=your_official_indeed_client_id
INDEED_CLIENT_SECRET=your_official_indeed_client_secret
INDEED_REDIRECT_URI=http://localhost:3000/api/auth/callback/indeed

# Email Notification Provider API Key (Resend / SendGrid / Nodemailer SMTP)
EMAIL_PROVIDER_KEY=your_official_email_service_api_key
EMAIL_FROM_ADDRESS=notifications@jobpilot.ai
CANDIDATE_NOTIFICATION_EMAIL=irfan.careers.tech@gmail.com
